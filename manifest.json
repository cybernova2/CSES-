{
  "manifest_version": 3,
  "name": "CSES+",
  "version": "0.1.0",
  "description": "A cleaner, modern interface for the CSES Problem Set. Works on top of cses.fi. No accounts, no tracking, no servers.",
  "permissions": ["storage"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self'"
  },
  "content_scripts": [
    {
      "matches": ["https://cses.fi/*"],
      "js": ["content/early.js"],
      "css": ["content/csesplus.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://cses.fi/*"],
      "js": ["content/main.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor/*"],
      "matches": ["https://cses.fi/*"]
    }
  ]
}
